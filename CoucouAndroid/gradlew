##############################################################################
#
#   Gradle wrapper script
#
#   Important for running:
#
#   (1) You need a JDK to run this script. If you have a JRE only,
#       the script will not work.
#
#   (2) This script will attempt to use the 'java' command from your
#       PATH. If this fails, you need to set JAVA_HOME.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing / if app_path ends with /
    [ -h "$app_path" ]
do
    app_path=$APP_HOME
    # If we have a symlink, resolve it
    if [ -h "$app_path" ]; then
        app_path=$( readlink -f "$app_path" )
    fi
    # Need to resolve the parent directory too
    APP_HOME=${app_path%"${app_path##*/}"}
done

# This is normally unused
DEFAULT_JVM_OPTS=('-Xmx64m' '-Xms64m')

# Use the maximum available, or set MAX_FD to a fixed value
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in
  CYGWIN* )           cygwin=true  ;;
  Darwin* )           darwin=true  ;;
  MSYS* | MINGW* )     msys=true   ;;
  NonStop* )          nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/bin/java" ] ; then
        JAVACMD=$JAVA_HOME/bin/java
    else
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in
      max*)
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
      ;;
    esac
    case $MAX_FD in
      '' | soft) :;;
      *)
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
      ;;
    esac
fi

# Collect all arguments for the java command
JVM_OPTS=("${DEFAULT_JVM_OPTS[@]}" "-Dorg.gradle.appname=$APP_BASE_NAME" "-Dfile.encoding=UTF-8")

# by default we should be in the correct directory, but when called from
# Finder on Mac, the cwd is the parent directory
if [ "$( echo "$APP_BASE_NAME" | grep -c / )" -gt 0 ]; then
    cd "$( dirname "$APP_BASE_NAME" )"
fi

# Use the maximum available memory
if [ "$cygwin" = "true" ] || [ "$msys" = "true" ] || [ "$darwin" = "true" ]; then
    JVM_OPTS+=("-Xss2m")
fi

exec "$JAVACMD" "${JVM_OPTS[@]}" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
